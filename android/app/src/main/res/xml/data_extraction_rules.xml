<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of this app leaves the device: the WebView's cookie jar holds the
     server session, the preferences hold the pinned certificate, and the
     page's storage holds the user's library offline. Android 12+ reads this
     for both cloud backup and device-to-device transfer (allowBackup="false"
     alone does not stop the transfer). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
