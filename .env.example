# Copy to .env (next to docker-compose.yml), edit, then: docker compose up --build
# docker compose automatically reads this file.

# Web UI / Subsonic login, auto-created on first boot. CHANGE THE PASSWORD.
SUPYSONIC_ADMIN_USER=admin
SUPYSONIC_ADMIN_PASSWORD=changeme

# Deezer ARL cookie (deezer.com -> DevTools -> Application -> Cookies -> "arl").
# Leave empty to run without the Deezer proxy.
DEEZER_ARL=

# Archive quality (what's permanently saved). Keep FLAC; the web player and
# Subsonic transcode to Opus on the fly when a lower quality is requested.
DEEZER_QUALITY=FLAC

# Auto-sync is ON by default: it syncs on startup and then daily at 04:00,
# importing your playlists, favorites and the Nouveautés/Découverte playlists.
# Override the daily time here (HH:MM) if you like; empty = keep the 04:00 default.
DEEZER_SYNC_AT=

# Send the tracks you play here back to Deezer (log.listen) so your Deezer
# recommendations and Flow keep learning from what you listen to. Opt-in:
# leave empty (off) or set to "yes" to enable.
DEEZER_REPORT_LISTENS=

# Database. Empty = built-in SQLite (fine to start). For production, switch to
# PostgreSQL: uncomment the `db` service + `depends_on` in docker-compose.yml,
# then set DATABASE_URI below. On the next boot your existing SQLite data is
# migrated to Postgres automatically (one-shot, transparent).
DATABASE_URI=
# DATABASE_URI=postgresql://supysonic:supysonic@db:5432/supysonic
# Password for the bundled Postgres service (must match DATABASE_URI above).
POSTGRES_PASSWORD=supysonic

# Web server concurrency (optional). Defaults: 1 worker / 8 threads / 120s.
# More threads = more simultaneous streams. Keep workers at 1.
# GUNICORN_THREADS=
# GUNICORN_TIMEOUT=
