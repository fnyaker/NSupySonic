[base]
; A database URI. See the 'schema' folder for schema creation scripts. Note that
; you don't have to run these scripts yourself.
; Default: sqlite:////tmp/supysonic/supysonic.db
;database_uri = sqlite:////var/supysonic/supysonic.db
;database_uri = mysql://supysonic:supysonic@localhost/supysonic
;database_uri = postgres://supysonic:supysonic@localhost/supysonic

; Optional, restrict scanner to these extensions. Default: none
;scanner_extensions = mp3 ogg

; Should the scanner follow symbolic links? Default: no
follow_symlinks = no

[webapp]
; Optional cache directory. Default: /tmp/supysonic
cache_dir = /var/supysonic/cache

; Main cache max size in MB. Default: 512
cache_size = 1024

; Transcode cache max size in MB. Default: 1024 (1GB)
transcode_cache_size = 1024

; Optional rotating log file. Default: none
log_file = /var/supysonic/supysonic.log

; Log level. Possible values: DEBUG, INFO, WARNING, ERROR, CRITICAL.
; Default: WARNING
log_level = WARNING

; Enable log rotation. Default: yes
log_rotate = yes

; Enable the Subsonic REST API. You'll most likely want to keep this on, here
; for testing purposes. Default: on
;mount_api = on

; Enable the administrative web interface. Default: on
;mount_webui = on

; Serve the bundled Deezer discovery SPA at /app (requires mount_webui).
; Build it with `cd webapp && npm run build` (the Docker image does this for
; you). Default: on
;mount_spa = on

; Add the Secure flag to the web UI session cookie so it is only ever sent over
; HTTPS. Turn this on when the server is exposed to the internet behind TLS.
; Leave off for plain-HTTP LAN access (a Secure cookie would never be stored).
; Default: off
;session_cookie_secure = off

; How long a web UI session cookie stays valid, in days (1-31). A signed cookie
; can't be revoked on its own, so this is the upper bound on a stolen one; a
; password change or a role change revokes outstanding sessions immediately
; regardless. Default: 7
;session_lifetime_days = 7

; Maximum accepted request body size in MB. Mainly bounds the web UI's
; "import files" upload; oversized requests are rejected with 413.
; 0 disables the limit. Default: 1024
;upload_max_size = 1024

; Per-user upload quota in GB for NON-admin accounts (admins upload without
; limit). This is only the initial default: an admin can change it live from
; the web UI (Settings), and that runtime value is stored in the database and
; takes precedence. 0 disables the per-user quota. Default: 5
;upload_quota_gb = 5

; Number of trusted reverse proxies in front of the server. 0 = the app is
; reached directly. When > 0, that many X-Forwarded-For / -Proto hops are
; trusted (ProxyFix), so request IP (rate limiting, logs) and HTTPS detection
; reflect the real client. SECURITY: only set this if a proxy you control is
; really in front — otherwise clients can spoof their IP and protocol.
; Default: 0
;proxy_fix_hops = 1

; Space separated list of prefixes that should be ignored on index endpoints
; Default: El La Le Las Les Los The
index_ignored_prefixes = El La Le Las Les Los The

; Look lyrics up online (LRCLIB, https://lrclib.net) when a track carries none
; of its own. Default: off
online_lyrics = off

[daemon]
; Socket file the daemon will listen on for incoming management commands
; Default: /tmp/supysonic/supysonic.sock
socket = /var/run/supysonic.sock

; Defines if the file watcher should be started. Default: yes
run_watcher = yes

; Delay in seconds before triggering scanning operation after a change have been
; detected.
; This prevents running too many scans when multiple changes are detected for a
; single file over a short time span. Default: 5
wait_delay = 5

; Command used by the jukebox
jukebox_command = mplayer -ss %offset %path

; Optional rotating log file for the scanner daemon. Logs to stderr if empty
log_file = /var/supysonic/supysonic-daemon.log
log_level = INFO
log_rotate = yes

[lastfm]
; API and secret key to enable scrobbling. http://www.last.fm/api/accounts
; Defaults: none
;api_key =
;secret =

[listenbrainz]
; root URL of the ListenBrainz API.
; Defaults: https://api.listenbrainz.org/
;api_url =

[transcoding]
; Programs used to convert from one format/bitrate to another. Defaults: none
; Opus transcoders for the Deezer proxy: a client requesting a bitrate gets Opus
; at that rate; requesting lossless gets the original archived FLAC.
transcoder_flac_opus = ffmpeg -i %srcpath -v 0 -map 0:a:0 -c:a libopus -b:a %outratek -vbr on -f ogg -
transcoder_mp3_opus = ffmpeg -i %srcpath -v 0 -map 0:a:0 -c:a libopus -b:a %outratek -vbr on -f ogg -
transcoder_mp3_mp3 = lame --quiet --mp3input -b %outrate %srcpath -
transcoder = ffmpeg -i %srcpath -ab %outratek -v 0 -f %outfmt -
decoder_mp3 = mpg123 --quiet -w - %srcpath
decoder_ogg = oggdec -Q -o - %srcpath
decoder_flac = flac -d -c -s %srcpath
encoder_mp3 = lame --quiet -b %outrate - -
encoder_ogg = oggenc2 -Q -M %outrate -

; Default format, used when a client requests a bitrate lower than the original
; file and no specific format
default_transcode_target = opus

[mimetypes]
; Extension to mimetype mappings in case your system has some trouble guessing
; Default: none
opus = audio/ogg
;mp3 = audio/mpeg
;ogg = audio/vorbis

[deezer]
; Turns the Deezer proxy on/off. Default: off
enabled = no

; Deezer ARL cookie of the account to proxy. Required when enabled.
; Get it from your browser cookies on deezer.com (cookie named "arl").
;arl =

; Folder where fetched FLAC files are permanently archived. Required when
; enabled. Registered as an additional "Deezer" root library folder.
;archive_dir = /var/supysonic/deezer-archive

; Quality fetched from Deezer and archived. FLAC | MP3_320 | MP3_128.
; Lower qualities requested by clients are produced by the existing transcoder
; from the archived file. FLAC requires a Deezer HiFi/Premium account.
; Default: FLAC
default_quality = FLAC

; supysonic username that owns imported Deezer playlists/favorites. Required
; for sync. Imported playlists appear under this user.
;sync_user = MyUserName

; What to import from Deezer on each sync.
sync_playlists = yes
sync_favorites = yes
import_new_releases = yes
import_flow = yes

; Refresh subscribed podcasts (shows) on each sync, and how many recent episodes
; to import per show. Subscribe via the Subsonic getPodcasts/createPodcastChannel
; endpoints or `supysonic-cli deezer import <deezer show url>`. Episode audio is
; archived on first play (MP3, from the podcast host — no FLAC/transcode-from-FLAC).
sync_podcasts = yes
podcast_episodes = 30

; Personalized "smart tracklists" exposed as "Deezer · <title>" playlists
; (requires import_new_releases). Space/comma separated ids. Leave unset for the
; default set. Known ids: new-releases, discovery, monthly-top, inspired-by-1
; ... inspired-by-5, flow.
;smart_tracklists = new-releases discovery monthly-top inspired-by-1 inspired-by-2 inspired-by-3 inspired-by-4 inspired-by-5

; Mirror Subsonic-side changes back to Deezer (create/edit playlists,
; star/unstar -> Deezer favorites). Default: yes
push_to_deezer = yes

; Report the tracks you play here back to Deezer (log.listen) so your Deezer
; recommendations and Flow keep learning from what you listen to. Default: no
report_listens = no

; Import audio files you drop into archive_dir (any format) as local library
; tracks (searchable/playlistable like Deezer tracks, but the Deezer sync never
; touches them). Scanned on each sync. Default: yes
scan_local = yes

; Pre-fetch & archive upcoming tracks (playlist/album in progress).
preload = yes
preload_count = 2
; Parallel workers for explicit "download now" requests (whole album/playlist
; pre-archiving, e.g. the web player's offline downloads). Higher = faster batch
; downloads. Capped at 8. Default: 4
download_workers = 4

; Auto-sync (runs from the web app — no cron needed). When a sync_user is set,
; a full sync runs on startup and then automatically; it refreshes playlists,
; favorites and the Nouveautés/Découverte smart-tracklist playlists.
; Run once on startup. Default: yes
sync_on_start = yes
; Daily sync time (HH:MM). Default: 04:00
sync_at = 04:00
; Or sync every N minutes instead (overrides sync_at when > 0). Default: 0
sync_interval = 0


; ---------------------------------------------------------------------------
; Server secrets (environment only — never set in this file)
; ---------------------------------------------------------------------------
;
; Three secrets protect the whole install: `password_secret` (decrypts the
; reversibly-stored passwords that Subsonic token auth needs), `cookies_secret`
; (signs session cookies) and `daemon_key` (authenticates to the management
; daemon). By default they are generated into the database — which means a
; leaked database dump contains both the data and the keys that protect it.
;
; On anything reachable from the internet, supply them out of band instead:
;
;   SUPYSONIC_SECRET_PASSWORD_SECRET=<long random string>
;   SUPYSONIC_SECRET_COOKIES_SECRET=<long random string>
;   SUPYSONIC_SECRET_DAEMON_KEY=<long random string>
;   SUPYSONIC_SECRETS_ENV_ONLY=1
;
; With SUPYSONIC_SECRETS_ENV_ONLY set, the server refuses to start rather than
; fall back to the database. Changing password_secret invalidates the stored
; recoverable passwords (token auth stops working until each user logs in once
; with a password); changing cookies_secret logs everyone out.
;
; SUPYSONIC_MIN_PASSWORD_LENGTH=12 additionally enforces a minimum password
; length on account creation and password changes (off by default).
