# ---> Python
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
.venv/
venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored to the repo root: these are Python build/venv artifacts. Unanchored
# (`lib/`) they also match webapp/src/lib/, which silently dropped the SPA's
# stores/api/actions modules from git and broke the Docker build.
/lib/
/lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
.env
downloads

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# ---> Vim
.*.sw[nop]
.netrwhist
*~

*.orig
.vscode
.claude
sourceproj

# Deezer API exploration captures (contain session tokens!)
tools/deezer_explore/*.har
tools/deezer_explore/*.catalog.json
tools/deezer_explore/*.catalog.md
tools/deezer_explore/probe.json
tools/deezer_explore/probe.md

# Local runtime config — contains your Deezer ARL. NEVER commit it.
# A sanitized template is tracked as config/supysonic.conf.example.
config/supysonic.conf
config/*.local.conf

# Svelte web UI build artifacts
webapp/node_modules/
webapp/dist/
webapp/package-lock.json
supysonic/webui/dist/

# partest: recorded per-test durations, used only to balance the next run
.partest-timings.json
