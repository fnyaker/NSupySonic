# VCS / CI
.git
.github

# Secrets / local runtime config — must never enter the build context
.env
.env.*
config
tools

# Local virtualenvs
.venv
venv
env

# Not needed to build/run the image (only supysonic* and deezerpy* are packaged).
# Every file sent here is hashed on every build, and a COPY of a directory is
# invalidated by any change inside it.
sourceproj
tests
docs
android
CLAUDE.md
# The SPA's test suite and benches: vite never reads them.
webapp/test

# Python build/cache artifacts
**/__pycache__
*.py[cod]
*.egg-info
build
dist
.eggs

# Node / SPA build artifacts (rebuilt in the webbuilder stage)
webapp/node_modules
webapp/dist
supysonic/webui/dist
# The rhythm analyser's Rust build output (rebuilt in the wasmbuilder stage)
# and the eval's cache of rendered test audio (hundreds of megabytes).
webapp/rhythm/target
webapp/rhythm/target-simd
webapp/appcore/target
webapp/trainer/target
webapp/trainer/target-simd
webapp/test/eval/.cache
webapp/test/render/out

# Coverage / editor
.coverage
.coverage.*
htmlcov
.vscode
*~
